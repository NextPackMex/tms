<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Tree (List) de Evidencias Fotográficas -->
    <record id="tms_evidence_photo_view_tree" model="ir.ui.view">
        <field name="name">tms.evidence.photo.tree</field>
        <field name="model">tms.evidence.photo</field>
        <field name="arch" type="xml">
            <list string="Evidencias Fotográficas">
                <field name="date" widget="datetime" string="Fecha/Hora"/>
                <field name="photo_type" widget="badge"/>
                <field name="user_id"/>
                <field name="notes"/>
                <field name="waybill_id"/>
            </list>
        </field>
    </record>

    <!-- Vista Form de Evidencias Fotográficas -->
    <record id="tms_evidence_photo_view_form" model="ir.ui.view">
        <field name="name">tms.evidence.photo.form</field>
        <field name="model">tms.evidence.photo</field>
        <field name="arch" type="xml">
            <form string="Evidencia Fotográfica">
                <sheet>
                    <group>
                        <group>
                            <field name="waybill_id" readonly="1"/>
                            <field name="photo_type" widget="radio"/>
                            <field name="user_id" readonly="1"/>
                            <field name="date" readonly="1"/>
                        </group>
                        <group>
                            <field name="photo_filename"/>
                            <field name="company_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="photo" widget="image" options="{'size': [300, 300]}"/>
                    </group>
                    <group>
                        <field name="notes" placeholder="Observaciones sobre la fotografía..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista Kanban de Evidencias (para usar dentro del waybill) -->
    <record id="tms_evidence_photo_view_kanban" model="ir.ui.view">
        <field name="name">tms.evidence.photo.kanban</field>
        <field name="model">tms.evidence.photo</field>
        <field name="arch" type="xml">
            <kanban default_group_by="photo_type" class="o_kanban_small_column">
                <field name="id"/>
                <field name="photo_type"/>
                <field name="date"/>
                <field name="user_id"/>
                <field name="photo"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card">
                            <div class="o_kanban_image">
                                <field name="photo" widget="image" options="{'size': [100, 100]}"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong><field name="photo_type" widget="badge"/></strong>
                                <p><small><field name="date"/></small></p>
                                <p><small><field name="user_id"/></small></p>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Vista Search de Evidencias — DEBE ESTAR ANTES DE LA ACCIÓN -->
    <record id="tms_evidence_photo_view_search" model="ir.ui.view">
        <field name="name">tms.evidence.photo.search</field>
        <field name="model">tms.evidence.photo</field>
        <field name="arch" type="xml">
            <search string="Buscar Evidencias">
                <field name="waybill_id"/>
                <field name="photo_type"/>
                <field name="user_id"/>
                <filter string="Tipo de Evidencia" name="group_type" domain="[]" context="{'group_by': 'photo_type'}"/>
                <filter string="Usuario" name="group_user" domain="[]" context="{'group_by': 'user_id'}"/>
            </search>
        </field>
    </record>

    <!-- Acción para abrir Evidencias desde el waybill -->
    <record id="action_tms_evidence_photo_view" model="ir.actions.act_window">
        <field name="name">Evidencias Fotográficas</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">tms.evidence.photo</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_id" ref="tms_evidence_photo_view_kanban"/>
        <field name="search_view_id" ref="tms_evidence_photo_view_search"/>
        <field name="help">Fotografías documentadas del viaje (salida, carga, entrega, odómetro, incidentes).</field>
    </record>


</odoo>
