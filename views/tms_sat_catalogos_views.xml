<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        ================================================================
        VISTAS — CATÁLOGOS SAT CFDI 4.0
        Sección 4: Uso CFDI, Forma de Pago, Método de Pago,
                   Tipo de Relación, Periodicidad de Pago
        ================================================================
    -->

    <!-- ══════════════════════════════════════
         USO CFDI (c_UsoCFDI)
         ══════════════════════════════════════ -->

    <record id="view_sat_uso_cfdi_list" model="ir.ui.view">
        <field name="name">tms.sat.uso.cfdi.list</field>
        <field name="model">tms.sat.uso.cfdi</field>
        <field name="arch" type="xml">
            <list string="Uso CFDI">
                <field name="code"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_sat_uso_cfdi_search" model="ir.ui.view">
        <field name="name">tms.sat.uso.cfdi.search</field>
        <field name="model">tms.sat.uso.cfdi</field>
        <field name="arch" type="xml">
            <search string="Buscar Uso CFDI">
                <field name="code" string="Código"/>
                <field name="name" string="Descripción"/>
                <field name="full_name" string="Uso CFDI"/>
            </search>
        </field>
    </record>

    <record id="action_sat_uso_cfdi" model="ir.actions.act_window">
        <field name="name">Uso CFDI</field>
        <field name="res_model">tms.sat.uso.cfdi</field>
        <field name="view_mode">list,form</field>
    </record>

