<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        ================================================================
        DASHBOARD TMS — KPIs Operativos en Tiempo Real
        ================================================================

        Implementación: ir.actions.client con componente OWL TmsDashboard.
        El componente llama a tms.waybill.get_dashboard_data() via RPC
        y renderiza 4 KPI cards + tabla por estado + alertas + top rutas.

        Menú "Dashboard" apunta a esta acción.
        El menú raíz TMS sigue abriendo la vista Kanban de waybills.
    -->

    <!-- Acción cliente del dashboard KPI -->
    <record id="action_tms_dashboard_kpi" model="ir.actions.client">
        <field name="name">Dashboard TMS</field>
        <field name="tag">tms_dashboard</field>
    </record>

    <!--
        ================================================================
        ACTION: Vista principal de waybills (Kanban operativo)
        ================================================================
        Referenciada por:
        - menu_tms_root (icono TMS en barra superior)
        - botón "Ver Viajes" en el componente dashboard
    -->
    <record id="action_tms_home" model="ir.actions.act_window">
        <field name="name">TMS - Viajes</field>
        <field name="res_model">tms.waybill</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_id" ref="view_tms_waybill_kanban"/>
        <field name="context">{}</field>
        <field name="domain">[]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear un nuevo viaje / cotización
            </p>
            <p>
                <strong>Single Document Flow:</strong>
                Cotización + Operación + Carta Porte fusionados.
            </p>
        </field>
    </record>

</odoo>
